PORT=5000

# Option 1: Standard local PostgreSQL configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=taj_hotels
DB_PASSWORD=your_postgres_password
DB_PORT=5432
DB_SSL=false

# Option 2: Full Connection String (e.g., for Neon, Supabase, Render, AWS RDS)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/taj_hotels
# DATABASE_SSL=false

# Optional connection pool settings
# DB_POOL_MAX=20
# DB_IDLE_TIMEOUT=30000
# DB_CONNECT_TIMEOUT=5000
